#!/usr/bin/env sh
#MISE description="Scan for secrets in files, a commit range (--range <range>), or the refs being pushed (--pushed)."
set -eu

config=".config/betterleaks.toml"

if [ "${1:-}" = "--range" ]; then
  exec betterleaks git --config "$config" --no-banner --redact --log-opts "$2" .
fi

# Scans the commits git is about to push. Reads git's pre-push lines from stdin:
# <local ref> <local sha> <remote ref> <remote sha>
if [ "${1:-}" = "--pushed" ]; then
  status=0
  while read -r _ local_sha _ remote_sha; do
    case "$local_sha" in
      *[!0]*) ;;
      *) continue ;; # all zeros: the push deletes a remote ref
    esac
    range="$remote_sha..$local_sha"
    case "$remote_sha" in
      *[!0]*) git cat-file -e "$remote_sha^{commit}" 2>/dev/null || range="$local_sha --not --remotes" ;;
      *) range="$local_sha --not --remotes" ;; # all zeros: a new remote ref
    esac
    betterleaks git --config "$config" --no-banner --redact --log-opts "$range" . || status=1
  done
  exit "$status"
fi

if [ "$#" -eq 0 ]; then
  git ls-files -z | xargs -0 -r betterleaks dir --config "$config" --no-banner --redact --
else
  betterleaks dir --config "$config" --no-banner --redact -- "$@"
fi
