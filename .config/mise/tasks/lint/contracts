#!/usr/bin/env sh
#MISE description="Check every document under docs/ against its structure contract"
set -eu

schemas=".config/mdschema"
status=0

fail() {
  echo "$1: $2" >&2
  status=1
}

# Prints the contract name for a path, "exempt", or "none".
contract_for() {
  base=$(basename "$1")
  if [ "$base" = README.md ]; then
    echo folder-guide
    return
  fi
  case "$1" in
    docs/designs/* | docs/plans/*)
      echo exempt
      return
      ;;
  esac
  # A template is checked against its folder's contract, but not against the filename and id rules.
  if [ "$base" = _template.md ]; then
    case "$(dirname "$1")" in
      docs/research/emulators) echo emulator-study ;;
      docs/research/topics) echo topic-study ;;
      docs/research/spikes) echo spike-report ;;
      docs/roadmap) echo roadmap ;;
      docs/adr) echo adr ;;
      docs/requirements) echo requirement ;;
      *) echo none ;;
    esac
    return
  fi
  case "$(dirname "$1")" in
    docs/research/emulators | docs/research/topics | docs/research/spikes)
      case "$base" in
        R[0-9]-[0-9][0-9]-?*.md)
          case "$(dirname "$1")" in
            docs/research/emulators) echo emulator-study ;;
            docs/research/topics) echo topic-study ;;
            *) echo spike-report ;;
          esac
          ;;
        *) echo none ;;
      esac
      ;;
    docs/roadmap) echo roadmap ;;
    docs/adr)
      case "$base" in
        [0-9][0-9][0-9][0-9]-?*.md) echo adr ;;
        *) echo none ;;
      esac
      ;;
    docs/requirements)
      case "$base" in
        REQ-[0-9][0-9][0-9][0-9]-?*.md) echo requirement ;;
        *) echo none ;;
      esac
      ;;
    *) echo none ;;
  esac
}

# Prints the top-level keys of a file's YAML frontmatter, one per line, without quotes.
# Any unindented line with a colon counts, so keys with spaces or slashes are caught too.
frontmatter_keys() {
  awk '
    NR == 1 && $0 != "---" { exit }
    NR > 1 && $0 == "---" { exit }
    NR > 1 && /^[^ \t#-]/ && index($0, ":") > 0 {
      key = substr($0, 1, index($0, ":") - 1)
      gsub(/^["\047 \t]+|["\047 \t]+$/, "", key)
      print key
    }
  ' "$1"
}

frontmatter_value() {
  awk -v key="$2" '
    NR == 1 && $0 != "---" { exit }
    NR > 1 && $0 == "---" { exit }
    NR > 1 && index($0, key ":") == 1 {
      value = substr($0, length(key) + 2)
      gsub(/^[ \t"\047]+|[ \t"\047]+$/, "", value)
      print value
    }
  ' "$1"
}

check() {
  file=${1#./}
  case "$file" in
    docs/*.md) ;;
    docs/*.[mM][dD] | docs/*.[mM][aA][rR][kK][dD][oO][wW][nN] | docs/*.[mM][dD][xX])
      fail "$file" "documents under docs/ must use the lower-case .md extension"
      return 0
      ;;
    *) return 0 ;;
  esac

  contract=$(contract_for "$file")
  case "$contract" in
    exempt) return 0 ;;
    none)
      fail "$file" "no structure contract covers this path. Valid locations: \
docs/research/{emulators,topics,spikes}/R<phase>-<nn>-<slug>.md (for example R1-32-mgba.md), \
docs/requirements/REQ-NNNN-<slug>.md, \
docs/adr/NNNN-<slug>.md, docs/roadmap/<name>.md, and a README.md in any folder. \
A new document type needs a contract in $schemas/ and an entry in this script."
      return 0
      ;;
  esac

  schema="$schemas/$contract.yml"
  mdschema check "$file" --schema "$schema" || status=1

  allowed=$(sed -n 's/^ *- name: *//p' "$schema")
  keys=$(mktemp)
  frontmatter_keys "$file" >"$keys"
  while IFS= read -r key; do
    if ! printf '%s\n' "$allowed" | grep -qxF -- "$key"; then
      fail "$file" "frontmatter field '$key' is not part of the $contract contract"
    fi
  done <"$keys"
  rm -f "$keys"

  [ "$(basename "$file")" = _template.md ] && return 0

  # The id in the frontmatter must equal the id at the start of the filename.
  case "$contract" in
    requirement)
      field=id
      width=8
      ;;
    emulator-study | topic-study | spike-report)
      field=roadmap_item
      width=5
      ;;
    *) return 0 ;;
  esac
  id=$(frontmatter_value "$file" "$field")
  expected=$(basename "$file" | cut -c1-"$width")
  if [ "$id" != "$expected" ]; then
    fail "$file" "frontmatter $field '$id' does not match the filename; expected '$expected'"
  fi
}

if [ "$#" -eq 0 ]; then
  files=$(mktemp)
  trap 'rm -f "$files"' EXIT
  git ls-files -- 'docs/' >"$files"
  while IFS= read -r file; do
    check "$file"
  done <"$files"
else
  for file in "$@"; do
    check "$file"
  done
fi

# A requirement id, an ADR number, or a roadmap item must belong to one file.
duplicates=$(git ls-files -- 'docs/requirements/REQ-*.md' \
  | sed -n 's|^docs/requirements/\(REQ-[0-9][0-9][0-9][0-9]\)-.*|\1|p' | sort | uniq -d)
for id in $duplicates; do
  fail "docs/requirements" "more than one requirement uses the id $id"
done

duplicates=$(git ls-files -- 'docs/adr/*.md' \
  | sed -n 's|^docs/adr/\([0-9][0-9][0-9][0-9]\)-.*|\1|p' | sort | uniq -d)
for id in $duplicates; do
  fail "docs/adr" "more than one ADR uses the number $id"
done

duplicates=$(git ls-files -- 'docs/research/*.md' \
  | sed -n 's|^docs/research/[a-z]*/\(R[0-9]-[0-9][0-9]\)-.*|\1|p' | sort | uniq -d)
for id in $duplicates; do
  fail "docs/research" "more than one research note uses the roadmap item $id"
done

# A research roadmap item is ticked exactly when its note is approved or superseded.
roadmap="docs/roadmap/research.md"
if [ -f "$roadmap" ]; then
  notes=$(mktemp)
  git ls-files -- 'docs/research/*.md' >"$notes"
  while IFS= read -r note; do
    id=$(basename "$note" | cut -c1-5)
    case "$id" in
      R[0-9]-[0-9][0-9]) ;;
      *) continue ;;
    esac
    [ -f "$note" ] || continue
    if ! grep -q "^- \[[ x]\] \*\*$id\*\*" "$roadmap"; then
      fail "$note" "the research roadmap has no item $id"
      continue
    fi
    ticked=no
    grep -q "^- \[x\] \*\*$id\*\*" "$roadmap" && ticked=yes
    case "$(frontmatter_value "$note" status)" in
      approved | superseded)
        [ "$ticked" = yes ] || fail "$note" "the note is approved but item $id is not ticked in $roadmap"
        ;;
      *)
        [ "$ticked" = no ] || fail "$note" "item $id is ticked in $roadmap but the note is not approved"
        ;;
    esac
  done <"$notes"
  ticked_ids=$(mktemp)
  sed -n 's/^- \[x\] \*\*\(R[0-9]-[0-9][0-9]\)\*\*.*/\1/p' "$roadmap" >"$ticked_ids"
  while IFS= read -r id; do
    grep -q "/$id-" "$notes" || fail "$roadmap" "item $id is ticked but has no research note"
  done <"$ticked_ids"
  rm -f "$ticked_ids"
  rm -f "$notes"
fi

exit "$status"
