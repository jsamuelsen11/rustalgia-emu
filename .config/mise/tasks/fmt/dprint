#!/usr/bin/env sh
#MISE description="Format YAML, JSON, and TOML. Pass --check first to fail instead of writing."
set -eu

mode="fmt"
if [ "${1:-}" = "--check" ]; then
  mode="check"
  shift
fi

if [ "$#" -eq 0 ]; then
  git ls-files -z -- '*.yml' '*.yaml' '*.json' '*.jsonc' '*.toml' \
    | xargs -0 -r dprint "$mode" --config .config/dprint.json --
else
  dprint "$mode" --config .config/dprint.json -- "$@"
fi
