#!/usr/bin/env sh
#MISE description="Format shell scripts. Pass --check first to fail instead of writing."
set -eu

mode="--write"
if [ "${1:-}" = "--check" ]; then
  mode="--diff"
  shift
fi

if [ "$#" -eq 0 ]; then
  git ls-files -z -- '.config/mise/tasks' '*.sh' | xargs -0 -r shfmt "$mode" --
else
  shfmt "$mode" -- "$@"
fi
