# --- Editors and operating systems ---------------------------------------------

# OpenIDEA shares .openidea/settings.toml and .openidea/run.toml.
# The editor keeps its per-user files out of git through .openidea/.gitignore, which it maintains itself.
.idea/
*.iml
.vscode/
*.code-workspace
.zed/
.fleet/
.history/
.DS_Store
._*
.AppleDouble
.Spotlight-V100
.Trashes
